// Original hypothetical workflow, not evidence of an implemented service.
digraph workflow {
  graph [rankdir=LR, bgcolor="transparent", pad=0.3, nodesep=0.5, ranksep=0.7,
    fontname="Malgun Gothic,Arial,sans-serif", fontsize=16, fontcolor="#17243B", splines=spline];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#BDCBDD",
    fontname="Malgun Gothic,Arial,sans-serif", fontsize=16, fontcolor="#17243B", margin="0.22,0.18", penwidth=1.3];
  edge [fontname="Malgun Gothic,Arial,sans-serif", fontsize=12, color="#2855C7", fontcolor="#2855C7", penwidth=1.8, arrowsize=0.8];
  subgraph cluster_request {
    label="01  요청 · 기준"; labeljust=l; style="rounded,filled"; color="#DEE6F1"; fillcolor="#F3F6FB"; margin=24;
    brief [label="요구 정리\n범위 · 완료 조건"];
    input [label="자료 준비\n원문 · 기준일"];
    brief -> input [label="기준 적용"];
  }
  subgraph cluster_review {
    label="02  제작 · 검증"; labeljust=l; style="rounded,filled"; color="#CAD8F5"; fillcolor="#EDF3FF"; margin=24;
    draft [label="초안 제작\n주장 · 근거 연결"];
    check [label="원문 대조\n수치 · 예외 확인"];
    draft -> check [label="검토 요청"];
  }
  done [label="전달 준비\n결과물 · 출처",fillcolor="#2855C7",fontcolor="white",color="#2855C7"];
  input -> draft [label="자료 전달"];
  check -> done [label="기준 충족"];
  check -> draft [xlabel="보완 후 재검토",color="#9A4D0B",fontcolor="#9A4D0B",style=dashed,constraint=false];
}
