// Original conceptual classification. Distance/area are not quantitative.
graph quality {
  graph [layout=twopi,root=quality,bgcolor="transparent",pad=0.4,ranksep=2.3,overlap=false,splines=true];
  node [shape=box,style="rounded,filled",fillcolor="#F3F6FB",color="#CCD7E5",fontname="Malgun Gothic,Arial,sans-serif",fontsize=17,fontcolor="#17243B",margin="0.22,0.16"];
  edge [color="#9BAEC8",penwidth=1.7];
  quality [label="설명력",fillcolor="#2855C7",fontcolor=white,color="#2855C7",fontsize=24];
  structure [label="정보 구조"];
  evidence [label="근거"];
  visual [label="시각 위계"];
  delivery [label="최종 전달"];
  quality -- structure;
  quality -- evidence;
  quality -- visual;
  quality -- delivery;
}
